POSTGRES_PASSWORD=change-me
# Owner login used only by the one-shot migrate service. Never give it to the app.
ADMIN_DATABASE_URL=postgres://food:change-me@db:5432/food_os
APP_DB_PASSWORD=change-me
POS_CREDENTIALS_KEY=
ALLOW_DEV_DINER=0
BACKUP_DB_PASSWORD=change-me
FOOD_ADMIN_DB_PASSWORD=change-me
# Comma-separated POS providers allowed to receive webhooks and nightly sync (e.g. petpooja,restroworks,urbanpiper).
# Empty means no POS provider is enabled. Set only after the vendor spec is confirmed.
POS_PROVIDERS_ENABLED=
# Pilot geo seeder (scripts/seed-pilot-geo.ts): mock restaurants for test and staging only.
# Leave both at 0 in production. The seeder never runs against the food_os production database.
# PILOT_SEED_ENABLED must be 1 for the seeder to run at all.
PILOT_SEED_ENABLED=0
# Also required when NODE_ENV=production. Setting it does not allow seeding food_os.
PILOT_SEED_ALLOW_PROD=0
