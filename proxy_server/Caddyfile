# Shared proxy. Domain hungrybro.pacewisdom.in is proxied by Cloudflare (orange cloud, SSL/TLS mode Full (strict)).
# TLS uses the Cloudflare Origin CA certificate that the owner places on the host at /etc/caddy/origin
# (mounted read-only into this container). No automatic certificates: Let's Encrypt HTTP challenges fail
# behind the Cloudflare proxy.
hungrybro.pacewisdom.in {
	tls /etc/caddy/origin/cert.pem /etc/caddy/origin/key.pem
	encode zstd gzip
	# Cloudflare sets CF-Connecting-IP to the real client address. Caddy overwrites X-Real-IP with it.
	reverse_proxy food-os-app:3000 {
		header_up X-Real-IP {header.CF-Connecting-IP}
	}
	header {
		-Server
	}
	log {
		output stdout
	}
}

# Plain HTTP only redirects to HTTPS.
http://hungrybro.pacewisdom.in {
	redir https://hungrybro.pacewisdom.in{uri} permanent
}
