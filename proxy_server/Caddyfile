# Shared proxy. Domain hungrybro.pacewisdom.in is proxied by Cloudflare.
# Cloudflare SSL mode is Flexible (set by the owner's boss; not changed here). Cloudflare therefore
# connects to this server over plain HTTP on port 80. This site serves HTTP only, with no redirect,
# which removes the redirect loop. Visitor-to-Cloudflare traffic stays HTTPS.
# RISK (accepted by the owner, to be reviewed): Cloudflare-to-server traffic is unencrypted.
http://hungrybro.pacewisdom.in {
	encode zstd gzip
	# Cloudflare sets CF-Connecting-IP to the real client address. Caddy overwrites X-Real-IP with it.
	reverse_proxy food-os-app:3000 {
		header_up X-Real-IP {header.CF-Connecting-IP}
	}
	header {
		-Server
	}
	log {
		output stdout
	}
}
