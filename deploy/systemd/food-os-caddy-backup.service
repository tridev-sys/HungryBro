[Unit]
Description=Weekly archive of the proxy-caddy-data volume to S3
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/home/ubuntu/docker
EnvironmentFile=/home/ubuntu/docker/.env
ExecStart=/home/ubuntu/docker/scripts/caddy-data-backup.sh backup
